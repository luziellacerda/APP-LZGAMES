{
  "expo": {
    "name": "LZ-GAMES",
    "slug": "lz-games",
    "version": "1.0.1",
    "description": "Aplicativo oficial da LZ Games para ordens de serviço, agenda, TurboRama, sorteios, benefícios e Games Usados.",
    "icon": "./assets/icon.png",
    "scheme": "lzgames",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "br.com.lzgames.app",
      "versionCode": 26,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07130f"
      }
    },
    "ios": {
      "bundleIdentifier": "br.com.lzgames.app",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-video",
      ["expo-image-picker", {"photosPermission":"Permita que a LZ-GAMES acesse suas fotos e vídeos para publicar produtos em Games Usados.","cameraPermission":false,"microphonePermission":false}],
      ["expo-notifications", {"color":"#FFD66B","defaultChannel":"sorteios"}],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#07130f"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://turbobox.lzgames.com.br/api/mobile/v1",
      "eas": {
        "projectId": "e16e4972-a5ab-4e40-9b50-25eb952c889c"
      }
    },
    "owner": "lzgames"
  }
}
