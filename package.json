{
  "name": "lz-games-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android:preview": "npm run check:push && npx eas-cli build --platform android --profile preview",
    "build:android:production": "npm run check:push && npx eas-cli build --platform android --profile production",
    "check:push": "node scripts/check-push-config.cjs",
    "test:push": "node --test scripts/push.test.cjs scripts/notification-controls.test.cjs",
    "test:agenda": "node --test scripts/agenda-auth.test.cjs scripts/appointment-details.test.cjs",
    "test:referrals": "node --test scripts/referrals.test.cjs",
    "test:orders": "node --test scripts/order-credit.test.cjs",
    "test:marketplace": "node --test scripts/marketplace.test.cjs scripts/marketplace-catalog.test.cjs server/marketplace/tests/media.test.js",
    "submit:android": "npx eas-cli submit --platform android --profile production",
    "typecheck": "tsc --noEmit",
    "test:effects": "node --test scripts/effects.test.cjs scripts/coin-rain.test.cjs scripts/trophy-lottie.test.cjs scripts/menu-lottie.test.cjs scripts/card-lottie.test.cjs"
  },
  "dependencies": {
    "expo": "57.0.20",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-image-picker": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.0",
    "expo-video": "~57.0.3",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@babel/plugin-transform-private-property-in-object": "^7.28.6",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.10",
    "typescript": "~6.0.3"
  }
}
